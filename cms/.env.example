HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

# Generate a long random string
SECRET=change-me

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Option A: local SQLite (easiest for development) ---
DB_CLIENT=sqlite3
DB_FILENAME=./data/data.db

# --- Option B: Supabase Postgres (production) ---
# Supabase dashboard > Connect > Session pooler connection string
# DB_CLIENT=pg
# DB_CONNECTION_STRING=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DB_SSL__REJECT_UNAUTHORIZED=false

# Allow the React frontend to call the API
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173

# Uploaded files (can be switched to Supabase Storage via S3 driver later)
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=./uploads
